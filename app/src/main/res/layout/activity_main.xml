XML
<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <WebView
        android:id="@+id/myWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_margin="10dp">

        <Button
            android:id="@+id/btnAccount1"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:text="Cuenta 1"
            android:textSize="10sp"
            android:alpha="0.8" />

        <Button
            android:id="@+id/btnAccount2"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:text="Cuenta 2"
            android:textSize="10sp"
            android:alpha="0.8"
            android:layout_marginStart="5dp" />

        <Button
            android:id="@+id/btnToggleControls"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:text="🎮 Gamepad"
            android:textSize="10sp"
            android:alpha="0.8"
            android:layout_marginStart="15dp" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/hudOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:layout_margin="20dp">

            <Button android:id="@+id/btnW" android:layout_width="50dp" android:layout_height="50dp" android:layout_gravity="center_horizontal" android:text="W" android:alpha="0.6" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/btnA" android:layout_width="50dp" android:layout_height="50dp" android:text="A" android:alpha="0.6" />
                <View android:layout_width="50dp" android:layout_height="50dp"/>
                <Button android:id="@+id/btnD" android:layout_width="50dp" android:layout_height="50dp" android:text="D" android:alpha="0.6" />
            </LinearLayout>
            <Button android:id="@+id/btnS" android:layout_width="50dp" android:layout_height="50dp" android:layout_gravity="center_horizontal" android:text="S" android:alpha="0.6" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="20dp">

            <Button android:id="@+id/btnQ" android:layout_width="55dp" android:layout_height="55dp" android:text="Q" android:alpha="0.6" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btnEsc" android:layout_width="55dp" android:layout_height="55dp" android:text="ESC" android:alpha="0.6"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
